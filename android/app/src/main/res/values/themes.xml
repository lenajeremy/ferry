<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="paper">#F3F1EC</color>
    <color name="ferry_orange">#EE5229</color>
    <style name="Theme.Ferry" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:colorAccent">@color/ferry_orange</item>
    </style>
    <style name="Theme.Ferry.Share" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
